# =============================================
# BACKEND Ayarları (Örnek)
# =============================================

# PostgreSQL Ayarları
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_PORT=5432

# MySQL Ayarları (Alternatif)
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=your_mysql_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3306

# JWT Secret (Gizli ve güçlü bir anahtar girin)
JWT_SECRET=your_super_secret_jwt_key_here_change_me_in_production

# IYZICO Sandbox Anahtarları (Iyzico panelinden alın)
IYZICO_API_KEY=sandbox-YOUR_IYZICO_API_KEY
IYZICO_SECRET_KEY=sandbox-YOUR_IYZICO_SECRET_KEY
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:8080/payment/callback

# E-MAIL (SMTP) Ayarları
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_app_password
