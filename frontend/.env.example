# =============================================
# FRONTEND Ayarları (Örnek)
# =============================================
# Frontend hangi port'ta yayın yapsın?
FRONTEND_PORT=3000

# Nginx, /api/* isteklerini hangi backend'e yönlendirsin?
# Docker Compose ağı içinde backend'e 'app' ismiyle ulaşıyoruz.
# Sunucuya taşırken: BACKEND_URL=http://senin-sunucu-ip:8080
BACKEND_URL=http://app:8080

# Vite build-time API prefix
VITE_API_BASE=/api
